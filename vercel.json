{
  "rewrites": [
    { "source": "/design/:slug", "destination": "/api/og" },
    { "source": "/illustration/:slug", "destination": "/api/og" },
    { "source": "/design", "destination": "/api/og" },
    { "source": "/illustration", "destination": "/api/og" },
    { "source": "/about", "destination": "/api/og" },
    { "source": "/contact", "destination": "/api/og" },
    { "source": "/", "destination": "/api/og" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
